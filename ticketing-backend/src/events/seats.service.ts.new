import {
  Injectable,
  BadRequestException,
  ConflictException,
} from '@nestjs/common';
import { InjectModel } from '@nestjs/mongoose';
import { Model } from 'mongoose';
import { Event, Seat, SeatSection } from './event.schema';

@Injectable()
export class SeatsService {
  constructor(@InjectModel(Event.name) private eventModel: Model<Event>) {}

  // Get seat map for an event - returns current seat statuses
  async getSeatMap(eventId: string) {
    const event = await this.eventModel.findById(eventId);
    if (!event) {
      throw new BadRequestException('Event not found');
    }

    if (!event.seatingLayout?.enabled) {
      return {
        event: {
          id: event._id,
          name: event.name,
          venue: event.venue,
          date: event.date,
          basePrice: event.ticketPrice,
        },
        seatingLayout: { enabled: false, sections: [] },
      };
    }

    // Log the seat statuses for debugging
    const unavailableSeats = event.seatingLayout.sections.flatMap((section) =>
      section.seats
        .filter((s) => s.status === 'unavailable')
        .map((s) => `${section.id}/${s.seatId}`),
    );
    console.log(
      `[SeatsService] getSeatMap: unavailable=${unavailableSeats.length} [${unavailableSeats.join(', ')}]`,
    );

    // Return the seating layout with current seat statuses
    return {
      event: {
        id: event._id,
        name: event.name,
        venue: event.venue,
        date: event.date,
        basePrice: event.ticketPrice,
      },
      seatingLayout: {
        enabled: event.seatingLayout.enabled,
        sections: event.seatingLayout.sections.map((section) => ({
          id: section.id,
          name: section.name,
          priceModifier: section.priceModifier || 0,
          seats: section.seats.map((seat) => ({
            seatId: seat.seatId,
            row: seat.row,
            column: seat.column,
            status: seat.status,
            price: event.ticketPrice + (section.priceModifier || 0),
          })),
        })),
      },
    };
  }

  // Initialize seats for an event when seating is created
  async initializeSeats(eventId: string, sections: SeatSection[]) {
    const event = await this.eventModel.findById(eventId);
    if (!event) {
      throw new BadRequestException('Event not found');
    }

    // Generate seat matrix for each section
    const initializedSections = sections.map((section) => ({
      id: section.id,
      name: section.name,
      priceModifier: section.priceModifier,
      accessibility: section.accessibility,
      seats: this.generateSeatMatrix(section),
    }));

    // Update event with initialized seating
    await this.eventModel.findByIdAndUpdate(eventId, {
      'seatingLayout.sections': initializedSections,
    });

    return initializedSections;
  }

  // Generate seat matrix from section info (rows and columns)
  private generateSeatMatrix(section: SeatSection): Seat[] {
    const seats: Seat[] = [];
    const sectionPrefix = section.name.charAt(0).toUpperCase();

    // Parse rows and columns from section
    const rows = (section as any).rows || 10;
    const columns = (section as any).columns || 10;

    for (let row = 1; row <= rows; row++) {
      for (let col = 0; col < columns; col++) {
        const columnLetter = String.fromCharCode(65 + col); // A, B, C...
        seats.push({
          seatId: `${sectionPrefix}-${columnLetter}${row}`,
          row,
          column: columnLetter,
          status: 'available',
        });
      }
    }

    return seats;
  }

  // DEPRECATED: Live reservation removed - seats only locked at payment
  async reserveSeats(
    eventId: string,
    seatIds: { sectionId: string; seatId: string }[],
  ) {
    console.log('[SeatsService] reserveSeats is DEPRECATED - use finalizePurchase at payment time');
    throw new BadRequestException('Live reservation disabled. Seats are locked only at payment.');
  }

  // DEPRECATED: Unreservation removed
  async unreserveSeats(
    eventId: string,
    seatIds: { sectionId: string; seatId: string }[],
  ) {
    console.log('[SeatsService] unreserveSeats is DEPRECATED');
    throw new BadRequestException('This endpoint is deprecated.');
  }

  // Finalize purchase - ATOMIC operation to prevent double-booking
  // This is the ONLY place where seats become unavailable
  async finalizePurchase(
    eventId: string,
    seatIds: { sectionId: string; seatId: string }[],
  ) {
    console.log('='.repeat(70));
    console.log('[SeatsService] *** FINALIZE PURCHASE - CRITICAL SECTION ***');
    console.log('[SeatsService] eventId:', eventId);
    console.log('[SeatsService] Seats to purchase:', JSON.stringify(seatIds));

    const event = await this.eventModel.findById(eventId);
    if (!event) {
      throw new BadRequestException('Event not found');
    }

    // SECURITY CHECK #1: Verify ALL seats exist and are currently available
    console.log('[SeatsService] [SECURITY CHECK #1] Verifying all seats are still available...');
    const unavailableSeats: string[] = [];

    for (const seatRequest of seatIds) {
      const section = event.seatingLayout.sections.find(
        (s) => s.id === seatRequest.sectionId,
      );
      if (!section) {
        throw new BadRequestException(
          `Section ${seatRequest.sectionId} not found`,
        );
      }

      const seat = section.seats.find((s) => s.seatId === seatRequest.seatId);
      if (!seat) {
        throw new BadRequestException(
          `Seat ${seatRequest.seatId} not found`,
        );
      }

      if (seat.status !== 'available') {
        unavailableSeats.push(
          `${seatRequest.sectionId}/${seatRequest.seatId} (status: ${seat.status})`,
        );
      }
    }

    if (unavailableSeats.length > 0) {
      console.log('[SeatsService] CONFLICT DETECTED: Seats no longer available:', unavailableSeats);
      throw new ConflictException(
        `The following seats are no longer available: ${unavailableSeats.join(', ')}. Please try again.`,
      );
    }

    console.log('[SeatsService] ✓ All seats verified as available');
    console.log('[SeatsService] [SECURITY CHECK #2] Performing ATOMIC purchase operations...');

    // SECURITY CHECK #2: Atomic update - only mark seats unavailable if they're still available
    // This is the critical race condition prevention
    for (const seatRequest of seatIds) {
      const section = event.seatingLayout.sections.find(
        (s) => s.id === seatRequest.sectionId,
      );

      // Atomic operation: Only update if seat status is still 'available'
      const updateResult = await this.eventModel.updateOne(
        {
          _id: eventId,
          // CRITICAL: Only match documents where the seat is still available
          'seatingLayout.sections.$[section].seats.$[seat].status': 'available',
        },
        {
          $set: {
            'seatingLayout.sections.$[section].seats.$[seat].status': 'unavailable',
          },
        },
        {
          arrayFilters: [
            { 'section.id': seatRequest.sectionId },
            { 'seat.seatId': seatRequest.seatId },
          ],
        },
      );

      console.log(
        `[SeatsService] Atomic update for ${seatRequest.seatId}: matched=${updateResult.matchedCount}, modified=${updateResult.modifiedCount}`,
      );

      // CRITICAL: If modifiedCount is 0, another customer just bought this seat
      if (updateResult.modifiedCount === 0) {
        console.log(`[SeatsService] *** RACE CONDITION DETECTED: Seat ${seatRequest.seatId} was just sold by another customer ***`);
        throw new ConflictException(
          `Seat ${seatRequest.seatId} was just sold by another customer. Purchase cancelled. Please try again.`,
        );
      }
    }

    console.log('[SeatsService] ✓ All seats atomically marked as unavailable');

    // Verify final state in database
    const finalEvent = await this.eventModel.findById(eventId);
    const finalUnavailableSeats = finalEvent?.seatingLayout.sections.flatMap(
      (section) =>
        section.seats
          .filter((s) => s.status === 'unavailable')
          .map((s) => `${section.id}/${s.seatId}`),
    ) || [];
    console.log('[SeatsService] Final unavailable seats in DB:', finalUnavailableSeats);

    console.log('[SeatsService] *** FINALIZE PURCHASE COMPLETED SUCCESSFULLY ***');
    console.log('='.repeat(70));

    return { soldSeats: seatIds };
  }
}
